---
import Base from '../layouts/Base.astro'

import Section from '../components/Section.astro'
import Socials from '../content/socials.astro'
import Timed from '../components/Timed.astro'

import { registration_secret, registration_start, registration_link } from '../data/con/photobooth.json'

const registration_start_weekday = new Date(registration_start)
  .toLocaleDateString('en', { weekday: 'long' })
  .toLowerCase()

const registration_start_time = new Date(registration_start).toLocaleTimeString('en', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false
})
---

<style lang="scss">
  @use '../styles/charter';

  .day-button {
    cursor: pointer;

    a {
      text-decoration: none;
    }
  }
</style>

<Base>
  <Section outerClass="bg-accent1-50" grid="grid-col-1 justify-items-center" innerClass="w-full" gap="gap-8">
    <h2 class="font-atari text-2xl md:text-3xl">Photoshoot</h2>
    <p class="text-center">
      You can signup for a photoshoot slot here, lorem ipsum dolor sit amet bla bla bla neat right?
    </p>
    <Timed start={registration_start}>
      <button class="p-2 text-neutral-50 bg-accent1-500 rounded font-semibold day-button">
        <Fragment set:html={`<!-- ${registration_secret} -->`} />
        <a href={registration_link}>Click here to sign up</a>
      </button>
      <button slot="else" class="p-2 text-neutral-50 bg-accent1-500 rounded font-semibold day-button">
        Signups open {registration_start_weekday} at {registration_start_time}
      </button>
    </Timed>
  </Section>
  <Socials />
</Base>
